<?xml version="1.0" encoding="utf-8"?>
<!--Drawer Layout-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--Activity Layout-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/data_transfer_main_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ui_background_homepage">

        <!--Export Hunts Section-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/export_hunts_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/data_transfer_margin"
            android:padding="@dimen/data_transfer_padding"
            android:gravity="center"
            android:background="@drawable/ui_textbox"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/import_hunts_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/export_hunts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/export_hunts_label"
                android:textSize="@dimen/text_size_x_large"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/export_hunts_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/export_hunts_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/export_hunts_description"
                android:textSize="@dimen/text_size_small"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/export_hunts_label"
                app:layout_constraintBottom_toTopOf="@id/export_hunts_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/export_hunts_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/export_hunts"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_export"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@id/export_hunts_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--Import Hunts Section-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/import_hunts_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/data_transfer_margin"
            android:padding="@dimen/data_transfer_padding"
            android:gravity="center"
            android:background="@drawable/ui_textbox"
            app:layout_constraintTop_toBottomOf="@id/export_hunts_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/import_hunts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/import_hunts_label"
                android:textSize="@dimen/text_size_x_large"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/import_hunts_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/import_hunts_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/import_hunts_description"
                android:textSize="@dimen/text_size_small"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/import_hunts_label"
                app:layout_constraintBottom_toTopOf="@id/import_hunts_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_hunts_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/import_hunts"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_import"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@id/import_hunts_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Navigation Layout-->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_drawer_menu"
        android:fitsSystemWindows="true" />

</androidx.drawerlayout.widget.DrawerLayout>